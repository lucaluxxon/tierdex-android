<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Android cloud backup is disabled in AndroidManifest.xml via
            android:allowBackup="false". No Tierdex local app data is
            intentionally included here.
        -->
    </cloud-backup>
    <device-transfer>
        <!--
            Device-to-device transfer backup is also disabled by the manifest
            setting. No local Tierdex app data is intentionally included here.
        -->
    </device-transfer>
</data-extraction-rules>
