rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPublicProfileWrite() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'searchDisplayName',
        'updatedAt',
        'bio',
        'profilePhotoPath'
      ])
        && request.resource.data.displayName is string
        && request.resource.data.searchDisplayName is string
        && (!('bio' in request.resource.data) ||
          (request.resource.data.bio is string &&
            request.resource.data.bio.size() <= 300))
        && (!('profilePhotoPath' in request.resource.data) ||
          request.resource.data.profilePhotoPath is string);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidPublicProfileWrite();
      allow delete: if false;
    }
  }
}
