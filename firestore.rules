rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function friendDocPath(ownerUid, friendUid) {
      return /databases/$(database)/documents/users/$(ownerUid)/friends/$(friendUid);
    }

    function incomingRequestDocPath(userId, fromUid) {
      return /databases/$(database)/documents/users/$(userId)/friendRequestsIncoming/$(fromUid);
    }

    function outgoingRequestDocPath(userId, toUid) {
      return /databases/$(database)/documents/users/$(userId)/friendRequestsOutgoing/$(toUid);
    }

    function isConfirmedFriend(ownerUid) {
      return isSignedIn()
        && exists(friendDocPath(ownerUid, request.auth.uid))
        && get(friendDocPath(ownerUid, request.auth.uid)).data.status == 'accepted';
    }

    function canReadFinding(ownerUid) {
      return isOwner(ownerUid) || isConfirmedFriend(ownerUid);
    }

    function allowedPublicProfileKeys() {
      return [
        'displayName',
        'searchDisplayName',
        'updatedAt',
        'bio',
        'profilePhotoPath',
        'profileBackgroundPhotoPath',
        'wishAnimalId',
        'favoriteAnimalId'
      ];
    }

    function isValidPublicProfileShape() {
      return request.resource.data.displayName is string
        && request.resource.data.searchDisplayName is string
        && (!('bio' in request.resource.data) ||
          (request.resource.data.bio is string &&
            request.resource.data.bio.size() <= 300))
        && (!('profilePhotoPath' in request.resource.data) ||
          request.resource.data.profilePhotoPath is string)
        && (!('profileBackgroundPhotoPath' in request.resource.data) ||
          request.resource.data.profileBackgroundPhotoPath is string)
        && (!('wishAnimalId' in request.resource.data) ||
          request.resource.data.wishAnimalId is string)
        && (!('favoriteAnimalId' in request.resource.data) ||
          request.resource.data.favoriteAnimalId is string);
    }

    function isValidPublicProfileCreate() {
      return request.resource.data.keys().hasOnly(allowedPublicProfileKeys())
        && isValidPublicProfileShape();
    }

    function isValidPublicProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedPublicProfileKeys())
        && isValidPublicProfileShape();
    }

    function isValidAnimalStatsWrite(animalId) {
      return request.resource.data.keys().hasOnly([
        'animalId',
        'globalFindingCount',
        'updatedAt'
      ])
        && request.resource.data.animalId is string
        && request.resource.data.animalId == animalId
        && (
          request.resource.data.globalFindingCount is int ||
          request.resource.data.globalFindingCount is float
        )
        && request.resource.data.globalFindingCount >= 0;
    }

    function isValidGlobalFindingContributionWrite() {
      return request.resource.data.keys().hasOnly([
        'ownerUid',
        'findingId',
        'animalId',
        'updatedAt'
      ])
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.findingId is string
        && request.resource.data.findingId.size() > 0
        && request.resource.data.animalId is string
        && request.resource.data.animalId.size() > 0;
    }

    function allowedFindingKeys() {
      return [
        'ownerId',
        'animalId',
        'date',
        'location',
        'note',
        'latitude',
        'longitude',
        'locationSource',
        'photoUri',
        'photoUris',
        'remotePhotoPath',
        'remotePhotoPaths',
        'thumbnailRemotePhotoPath',
        'taggedFriendIds',
        'createdAt',
        'updatedAt'
      ];
    }

    function isNullableStringWithMaxLength(value, maxLength) {
      return value == null ||
        (value is string && value.size() <= maxLength);
    }

    function isNullableTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isNullableLatitude(value) {
      return value == null ||
        (value is number && value >= -90 && value <= 90);
    }

    function isNullableLongitude(value) {
      return value == null ||
        (value is number && value >= -180 && value <= 180);
    }

    function isOptionalOwnedFindingStoragePath(ownerUid, value) {
      return value == null ||
        (value is string &&
          value.size() <= 500 &&
          (
            value.size() == 0 ||
            value.matches('^(storage://)?users/' + ownerUid + '/findings/.+')
          ));
    }

    function isValidFindingShape(ownerUid) {
      return (!('ownerId' in request.resource.data) ||
          (request.resource.data.ownerId is string &&
            request.resource.data.ownerId == ownerUid &&
            request.resource.data.ownerId.size() <= 128))
        && request.resource.data.animalId is string
        && request.resource.data.animalId.size() > 0
        && request.resource.data.animalId.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0
        && request.resource.data.date.size() <= 40
        && request.resource.data.location is string
        && request.resource.data.location.size() <= 200
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000
        && (!('latitude' in request.resource.data) ||
          isNullableLatitude(request.resource.data.latitude))
        && (!('longitude' in request.resource.data) ||
          isNullableLongitude(request.resource.data.longitude))
        && (!('locationSource' in request.resource.data) ||
          isNullableStringWithMaxLength(request.resource.data.locationSource, 40))
        && (!('photoUri' in request.resource.data) ||
          isNullableStringWithMaxLength(request.resource.data.photoUri, 2000))
        && (!('photoUris' in request.resource.data) ||
          (request.resource.data.photoUris is list &&
            request.resource.data.photoUris.size() <= 3))
        && (!('remotePhotoPath' in request.resource.data) ||
          isOptionalOwnedFindingStoragePath(ownerUid, request.resource.data.remotePhotoPath))
        && (!('remotePhotoPaths' in request.resource.data) ||
          (request.resource.data.remotePhotoPaths is list &&
            request.resource.data.remotePhotoPaths.size() <= 3))
        && (!('thumbnailRemotePhotoPath' in request.resource.data) ||
          isOptionalOwnedFindingStoragePath(ownerUid, request.resource.data.thumbnailRemotePhotoPath))
        && (!('taggedFriendIds' in request.resource.data) ||
          (request.resource.data.taggedFriendIds is list &&
            request.resource.data.taggedFriendIds.size() <= 10))
        && (!('createdAt' in request.resource.data) ||
          isNullableTimestamp(request.resource.data.createdAt))
        && (!('updatedAt' in request.resource.data) ||
          isNullableTimestamp(request.resource.data.updatedAt));
    }

    function isValidFindingCreate(ownerUid) {
      return request.resource.data.keys().hasOnly(allowedFindingKeys())
        && isValidFindingShape(ownerUid);
    }

    function isValidFindingUpdate(ownerUid) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFindingKeys())
        && isValidFindingShape(ownerUid);
    }

    function allowedLikeKeys() {
      return [
        'likerUid',
        'likerDisplayName',
        'createdAt'
      ];
    }

    function isValidLikeWrite(likerUid) {
      return request.resource.data.keys().hasOnly(allowedLikeKeys())
        && request.resource.data.likerUid is string
        && request.resource.data.likerUid == likerUid
        && (!('likerDisplayName' in request.resource.data) ||
          request.resource.data.likerDisplayName is string)
        && (!('createdAt' in request.resource.data) ||
          request.resource.data.createdAt is timestamp);
    }

    function allowedCommentKeys() {
      return [
        'commenterUid',
        'commenterDisplayName',
        'text',
        'createdAt'
      ];
    }

    function isValidCommentWrite(commenterUid) {
      return request.resource.data.keys().hasOnly(allowedCommentKeys())
        && request.resource.data.commenterUid is string
        && request.resource.data.commenterUid == commenterUid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && (!('commenterDisplayName' in request.resource.data) ||
          request.resource.data.commenterDisplayName is string)
        && (!('createdAt' in request.resource.data) ||
          request.resource.data.createdAt is timestamp);
    }

    function isValidFriendEntry(userId, friendUid) {
      return request.resource.data.keys().hasOnly([
        'friendUserId',
        'status',
        'createdAt'
      ])
        && request.resource.data.friendUserId is string
        && request.resource.data.friendUserId == friendUid
        && request.resource.data.status is string
        && request.resource.data.status == 'accepted'
        && (!('createdAt' in request.resource.data) ||
          request.resource.data.createdAt is timestamp);
    }

    function isValidAcceptedFriendDataAfter(userId, friendUid) {
      return existsAfter(friendDocPath(userId, friendUid))
        && getAfter(friendDocPath(userId, friendUid)).data.keys().hasOnly([
          'friendUserId',
          'status',
          'createdAt'
        ])
        && getAfter(friendDocPath(userId, friendUid)).data.friendUserId is string
        && getAfter(friendDocPath(userId, friendUid)).data.friendUserId == friendUid
        && getAfter(friendDocPath(userId, friendUid)).data.status is string
        && getAfter(friendDocPath(userId, friendUid)).data.status == 'accepted'
        && (!('createdAt' in getAfter(friendDocPath(userId, friendUid)).data) ||
          getAfter(friendDocPath(userId, friendUid)).data.createdAt is timestamp);
    }

    function hasPendingFriendRequest(recipientUid, requesterUid) {
      return exists(incomingRequestDocPath(recipientUid, requesterUid))
        && exists(outgoingRequestDocPath(requesterUid, recipientUid))
        && get(incomingRequestDocPath(recipientUid, requesterUid)).data.status == 'pending'
        && get(outgoingRequestDocPath(requesterUid, recipientUid)).data.status == 'pending';
    }

    function isAllowedSymmetricFriendAcceptWrite(userId, friendUid) {
      return isSignedIn()
        && (request.auth.uid == userId || request.auth.uid == friendUid)
        && isValidFriendEntry(userId, friendUid)
        && (
          (request.auth.uid == userId && hasPendingFriendRequest(userId, friendUid)) ||
          (request.auth.uid == friendUid && hasPendingFriendRequest(friendUid, userId))
        )
        && isValidAcceptedFriendDataAfter(userId, friendUid)
        && isValidAcceptedFriendDataAfter(friendUid, userId);
    }

    function isAllowedSymmetricFriendRemove(userId, friendUid) {
      return isSignedIn()
        && (request.auth.uid == userId || request.auth.uid == friendUid)
        && exists(friendDocPath(userId, friendUid))
        && exists(friendDocPath(friendUid, userId))
        && get(friendDocPath(userId, friendUid)).data.friendUserId == friendUid
        && get(friendDocPath(userId, friendUid)).data.status == 'accepted'
        && get(friendDocPath(friendUid, userId)).data.friendUserId == userId
        && get(friendDocPath(friendUid, userId)).data.status == 'accepted'
        && !existsAfter(friendDocPath(userId, friendUid))
        && !existsAfter(friendDocPath(friendUid, userId));
    }

    function isValidIncomingRequest(userId, fromUid) {
      return request.resource.data.keys().hasOnly([
        'fromUserId',
        'toUserId',
        'status',
        'createdAt'
      ])
        && request.resource.data.fromUserId is string
        && request.resource.data.fromUserId == fromUid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId == userId
        && request.resource.data.status is string
        && request.resource.data.status == 'pending'
        && (!('createdAt' in request.resource.data) ||
          request.resource.data.createdAt is timestamp);
    }

    function isValidOutgoingRequest(userId, toUid) {
      return request.resource.data.keys().hasOnly([
        'fromUserId',
        'toUserId',
        'status',
        'createdAt'
      ])
        && request.resource.data.fromUserId is string
        && request.resource.data.fromUserId == userId
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId == toUid
        && request.resource.data.status is string
        && request.resource.data.status == 'pending'
        && (!('createdAt' in request.resource.data) ||
          request.resource.data.createdAt is timestamp);
    }

    function allowedNotificationKeys() {
      return [
        'type',
        'title',
        'message',
        'createdAt',
        'updatedAt',
        'actorUid',
        'actorDisplayName',
        'recipientUid',
        'relatedOwnerUserId',
        'relatedFindingId',
        'relatedAnimalId',
        'relatedRequestUserId',
        'sourcePath',
        'legacyIds',
        'isRead',
        'readAt',
        'schemaVersion'
      ];
    }

    function isValidNotificationReadUpdate(userId) {
      return request.resource.data.keys().hasOnly(allowedNotificationKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead',
          'readAt'
        ])
        && request.resource.data.recipientUid is string
        && request.resource.data.recipientUid == userId
        && request.resource.data.isRead is bool
        && (!('readAt' in request.resource.data) ||
          request.resource.data.readAt is timestamp);
    }

    function isValidXpStateWrite() {
      return request.resource.data.keys().hasOnly([
          'totalXp',
          'awardedXpKeys',
          'backfillV1Done',
          'schemaVersion',
          'updatedAt'
        ])
        && request.resource.data.totalXp is int
        && request.resource.data.totalXp >= 0
        && request.resource.data.totalXp <= 10000000
        && request.resource.data.awardedXpKeys is list
        && request.resource.data.awardedXpKeys.size() <= 5000
        && request.resource.data.backfillV1Done is bool
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidQuestStateWrite() {
      return request.resource.data.keys().hasOnly([
          'socialLikesGivenCount',
          'socialCommentsWrittenCount',
          'dailyAnimalQuestHitFindingIds',
          'schemaVersion',
          'updatedAt'
        ])
        && request.resource.data.socialLikesGivenCount is int
        && request.resource.data.socialLikesGivenCount >= 0
        && request.resource.data.socialLikesGivenCount <= 100000
        && request.resource.data.socialCommentsWrittenCount is int
        && request.resource.data.socialCommentsWrittenCount >= 0
        && request.resource.data.socialCommentsWrittenCount <= 100000
        && request.resource.data.dailyAnimalQuestHitFindingIds is list
        && request.resource.data.dailyAnimalQuestHitFindingIds.size() <= 5000
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidPublicProfileCreate();
      allow update: if isOwner(userId) && isValidPublicProfileUpdate();
      allow delete: if false;

      match /findings/{findingId} {
        allow read: if canReadFinding(userId);
        allow create: if isOwner(userId) && isValidFindingCreate(userId);
        allow update: if isOwner(userId) && isValidFindingUpdate(userId);
        allow delete: if isOwner(userId);

        match /likes/{likerUid} {
          allow read: if canReadFinding(userId);
          allow create, update: if request.auth != null
            && request.auth.uid == likerUid
            && canReadFinding(userId)
            && isValidLikeWrite(likerUid);
          allow delete: if request.auth != null && request.auth.uid == likerUid;
        }

        match /comments/{commentId} {
          allow read: if canReadFinding(userId);
          allow create: if request.auth != null
            && canReadFinding(userId)
            && isValidCommentWrite(request.auth.uid);
          allow update: if request.auth != null
            && (isOwner(userId) || request.auth.uid == resource.data.commenterUid)
            && isValidCommentWrite(resource.data.commenterUid);
          allow delete: if request.auth != null
            && (isOwner(userId) || request.auth.uid == resource.data.commenterUid);
        }
      }

      match /friends/{friendUid} {
        allow read: if isOwner(userId);
        allow create, update: if isAllowedSymmetricFriendAcceptWrite(userId, friendUid);
        allow delete: if isAllowedSymmetricFriendRemove(userId, friendUid);
      }

      match /friendRequestsIncoming/{fromUid} {
        allow read: if isOwner(userId);
        allow create: if request.auth != null
          && request.auth.uid == fromUid
          && isValidIncomingRequest(userId, fromUid);
        allow delete: if isOwner(userId) || (request.auth != null && request.auth.uid == fromUid);
        allow update: if false;
      }

      match /friendRequestsOutgoing/{toUid} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOutgoingRequest(userId, toUid);
        allow delete: if isOwner(userId) || (request.auth != null && request.auth.uid == toUid);
        allow update: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if isOwner(userId) && isValidNotificationReadUpdate(userId);
        allow delete: if false;
      }

      match /private/meta/xpState/state {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidXpStateWrite();
        allow delete: if false;
      }

      match /private/meta/questState/state {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidQuestStateWrite();
        allow delete: if false;
      }

      match /private/{privatePath=**} {
        allow read, write: if isOwner(userId)
          && privatePath != "meta/xpState/state"
          && privatePath != "meta/questState/state";
      }
    }

    match /animalStats/{animalId} {
      allow read: if isSignedIn();
      allow create, update: if false;
      allow delete: if false;
    }

    match /dailyAnimals/{dateKey} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    match /globalFindingContributions/{contributionId} {
      allow read: if false;
      allow create, update: if false;
      allow delete: if false;
    }
  }
}
