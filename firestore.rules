rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function allowedPublicProfileKeys() {
      return [
        'displayName',
        'searchDisplayName',
        'updatedAt',
        'bio',
        'profilePhotoPath',
        'profileBackgroundPhotoPath',
        'wishAnimalId',
        'favoriteAnimalId'
      ];
    }

    function isValidPublicProfileShape() {
      return request.resource.data.displayName is string
        && request.resource.data.searchDisplayName is string
        && (!('bio' in request.resource.data) ||
          (request.resource.data.bio is string &&
            request.resource.data.bio.size() <= 300))
        && (!('profilePhotoPath' in request.resource.data) ||
          request.resource.data.profilePhotoPath is string)
        && (!('profileBackgroundPhotoPath' in request.resource.data) ||
          request.resource.data.profileBackgroundPhotoPath is string)
        && (!('wishAnimalId' in request.resource.data) ||
          request.resource.data.wishAnimalId is string)
        && (!('favoriteAnimalId' in request.resource.data) ||
          request.resource.data.favoriteAnimalId is string);
    }

    function isValidPublicProfileCreate() {
      return request.resource.data.keys().hasOnly(allowedPublicProfileKeys())
        && isValidPublicProfileShape();
    }

    function isValidPublicProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedPublicProfileKeys())
        && isValidPublicProfileShape();
    }

    function isValidAnimalStatsWrite(animalId) {
      return request.resource.data.keys().hasOnly([
        'animalId',
        'globalFindingCount',
        'updatedAt'
      ])
        && request.resource.data.animalId is string
        && request.resource.data.animalId == animalId
        && (
          request.resource.data.globalFindingCount is int ||
          request.resource.data.globalFindingCount is float
        )
        && request.resource.data.globalFindingCount >= 0;
    }

    function isValidGlobalFindingContributionWrite() {
      return request.resource.data.keys().hasOnly([
        'ownerUid',
        'findingId',
        'animalId',
        'updatedAt'
      ])
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.findingId is string
        && request.resource.data.findingId.size() > 0
        && request.resource.data.animalId is string
        && request.resource.data.animalId.size() > 0;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && isValidPublicProfileCreate();
      allow update: if isOwner(userId) && isValidPublicProfileUpdate();
      allow delete: if false;

      match /private/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /animalStats/{animalId} {
      allow read, write: if request.auth != null;
    }

    match /dailyAnimals/{dateKey} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && !exists(/databases/$(database)/documents/dailyAnimals/$(dateKey))
        && request.resource.data.keys().hasOnly([
          'animalId',
          'date',
          'createdAt'
        ])
        && request.resource.data.animalId is string
        && request.resource.data.animalId.size() > 0
        && request.resource.data.date is string
        && request.resource.data.date == dateKey
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }

    match /globalFindingContributions/{contributionId} {
      allow read, write: if request.auth != null;
    }
  }
}
